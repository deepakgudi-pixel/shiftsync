# Neon PostgreSQL — get from neon.tech
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# AES-256-GCM key for encrypted messaging (64 char hex)
ENCRYPTION_KEY=64_char_hex_key_for_aes_256_gcm

# Clerk — get from clerk.com
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Demo access (optional — only for local development)
DEMO_ACCESS_ENABLED=true
DEMO_PASSWORD=your_secure_demo_password
