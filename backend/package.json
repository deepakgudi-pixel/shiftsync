{
  "name": "shiftsync-backend",
  "version": "1.0.0",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "typecheck": "tsc --noEmit",
    "demo:check": "node src/scripts/check-demo-env.js",
    "demo:seed": "npm run demo:check && npm run db:setup && npm run db:seed && npm run db:seed:scenario",
    "db:setup": "node src/db/setup.js",
    "db:seed": "node src/db/seed.js",
    "db:seed:scenario": "node src/scripts/seed-demo-scenario.js"
  },
  "dependencies": {
    "@clerk/backend": "^1.0.0",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.0",
    "express": "^4.18.0",
    "express-rate-limit": "^8.4.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.0.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.11.0",
    "socket.io": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "eslint": "^8.57.1",
    "nodemon": "^3.1.0",
    "typescript": "^5.9.3"
  }
}
